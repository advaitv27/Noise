{
  "name": "noise-desktop",
  "version": "1.1.3",
  "description": "Professional Collaborative Desktop Calendar Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:dir": "electron-builder --dir",
    "release": "electron-builder --win --publish always",
    "deploy:web": "firebase deploy --only hosting"
  },
  "keywords": [
    "calendar",
    "collaboration",
    "desktop",
    "electron",
    "team-planner"
  ],
  "author": "Broklyn Studios",
  "license": "MIT",
  "build": {
    "appId": "com.noise.desktop",
    "productName": "Noise",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      ".env"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Noise"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9"
  }
}
